{% liquid
  assign message = block.settings.message
  if template.name == 'product' and product and block.settings.product_message_enabled
    assign product_url = request.origin | append: product.url
    assign message = block.settings.product_message | replace: '[product_title]', product.title | replace: '[product_url]', product_url
  endif
  assign encoded_message = message | strip | url_encode | replace: '+', '%20'
  assign label = block.settings.label | strip | default: 'Chat with us'

  assign valid_agents = 0
  assign agent_errors = ''
  for i in (1..3)
    assign key_phone = 'agent_' | append: i | append: '_phone'
    assign key_name = 'agent_' | append: i | append: '_name'
    assign raw_phone = block.settings[key_phone] | strip
    if raw_phone == blank
      continue
    endif
    assign phone = raw_phone | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
    assign non_digits = phone | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
    assign first_digit = phone | slice: 0
    if non_digits != blank or first_digit == '0' or phone.size < 8 or phone.size > 15
      assign agent_name = block.settings[key_name] | default: 'Agent' | escape
      assign safe_phone = raw_phone | escape
      assign agent_errors = agent_errors | append: '<li>' | append: agent_name | append: ': “' | append: safe_phone | append: '”</li>'
    else
      assign valid_agents = valid_agents | plus: 1
    endif
  endfor

  assign open_days = ''
  assign day_keys = 'hours_sun,hours_mon,hours_tue,hours_wed,hours_thu,hours_fri,hours_sat' | split: ','
  for day_key in day_keys
    if block.settings[day_key]
      assign open_days = open_days | append: forloop.index0 | append: ','
    endif
  endfor
%}
{% if valid_agents > 0 %}
  <div
    class="wa-chat wa-chat--{{ block.settings.position }}{% unless block.settings.show_label %} wa-chat--icon-only{% endunless %}{% unless block.settings.show_mobile %} wa-chat--hide-mobile{% endunless %}{% unless block.settings.show_desktop %} wa-chat--hide-desktop{% endunless %}"
    style="--wa-background: {{ block.settings.background }}; --wa-foreground: {{ block.settings.foreground }}; --wa-bottom: {{ block.settings.bottom_offset }}px;"
    data-wa-chat
    data-hours-enabled="{{ block.settings.hours_enabled }}"
    data-days="{{ open_days }}"
    data-open="{{ block.settings.open_time }}"
    data-close="{{ block.settings.close_time }}"
    data-time-zone="{{ block.settings.time_zone }}"
    data-store-offset="{{ 'now' | date: '%z' }}"
    data-online-label="{{ 'wa_chat.status.online' | t | escape }}"
    data-away-label="{{ 'wa_chat.status.away' | t | escape }}"
    data-open24-label="{{ 'wa_chat.status.open_24_hours' | t | escape }}"
    data-online-heading="{{ 'wa_chat.agents.online_heading' | t | escape }}"
    data-offline-heading="{{ 'wa_chat.agents.offline_heading' | t | escape }}"
    {{ block.shopify_attributes }}
  >
    <details class="wa-chat__details"{% if request.design_mode %} open{% endif %}>
      <summary class="wa-chat__button" aria-label="{{ label | escape }}">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M21 11.5a9 9 0 0 1-13.3 7.9L3 21l1.6-4.7A9 9 0 1 1 21 11.5Z"/>
          <path d="M8 7.5c-.5 3.8 2.7 7 6.5 7l1-2-2-1-.8 1c-1.5-.6-2.6-1.7-3.2-3.2l1-.8-1-2Z"/>
        </svg>
        {% if block.settings.show_label %}<span>{{ label | escape }}</span>{% endif %}
      </summary>
      <div class="wa-chat__panel">
        <div class="wa-chat__header">
          <p class="wa-chat__title">{{ block.settings.greeting_title | escape }}</p>
          {% if block.settings.greeting_text != blank %}
            <p class="wa-chat__subtitle">{{ block.settings.greeting_text | escape }}</p>
          {% endif %}
          <div class="wa-chat__status" data-wa-status hidden>
            <p class="wa-chat__status-line"><span class="wa-chat__dot" aria-hidden="true"></span><span data-wa-status-text></span></p>
            <p class="wa-chat__hours" data-wa-hours></p>
          </div>
          <button type="button" class="wa-chat__close" data-wa-close aria-label="{{ 'wa_chat.general.close' | t | escape }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
        <div class="wa-chat__body">
          {% if request.design_mode and agent_errors != blank %}
            <div class="wa-chat__notice">
              These WhatsApp numbers aren’t valid and are hidden. Use the country code followed by the number, digits only, with no leading zero (for example 923001234567).
              <ul>{{ agent_errors }}</ul>
            </div>
          {% endif %}
          <p class="wa-chat__offline" data-wa-offline data-template="{{ block.settings.offline_message | escape }}" hidden></p>
          <p class="wa-chat__list-heading" data-wa-list-heading>{{ 'wa_chat.agents.online_heading' | t }}</p>
          <ul class="wa-chat__agents" role="list">
            {% for i in (1..3) %}
              {% liquid
                assign key_phone = 'agent_' | append: i | append: '_phone'
                assign key_name = 'agent_' | append: i | append: '_name'
                assign key_role = 'agent_' | append: i | append: '_role'
                assign phone = block.settings[key_phone] | strip | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
                assign non_digits = phone | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
                assign first_digit = phone | slice: 0
                if phone == blank or non_digits != blank or first_digit == '0' or phone.size < 8 or phone.size > 15
                  continue
                endif
                assign agent_name = block.settings[key_name] | strip | default: 'WhatsApp'
                assign agent_role = block.settings[key_role] | strip
              %}
              <li>
                <a
                  class="wa-chat__agent"
                  href="https://wa.me/{{ phone }}{% if encoded_message != blank %}?text={{ encoded_message | escape }}{% endif %}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="wa-chat__avatar" aria-hidden="true">{{ agent_name | slice: 0 | upcase | escape }}</span>
                  <span class="wa-chat__agent-text">
                    <span class="wa-chat__agent-name">{{ agent_name | escape }}</span>
                    {% if agent_role != blank %}<span class="wa-chat__agent-role">{{ agent_role | escape }}</span>{% endif %}
                  </span>
                  <span class="wa-chat__visually-hidden">({{ 'wa_chat.agents.opens_whatsapp' | t }})</span>
                  <svg class="wa-chat__agent-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M21 11.5a9 9 0 0 1-13.3 7.9L3 21l1.6-4.7A9 9 0 1 1 21 11.5Z"/>
                    <path d="M8 7.5c-.5 3.8 2.7 7 6.5 7l1-2-2-1-.8 1c-1.5-.6-2.6-1.7-3.2-3.2l1-.8-1-2Z"/>
                  </svg>
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </details>
  </div>
{% elsif request.design_mode %}
  <div class="wa-chat-setup" {{ block.shopify_attributes }}>
    {% if agent_errors == blank %}
      WhatsApp Chat Pro: add at least one agent’s WhatsApp number in this app embed’s settings.
    {% else %}
      WhatsApp Chat Pro: these WhatsApp numbers aren’t valid. Use the country code followed by the number, digits only, with no leading zero (for example 923001234567).
      <ul>{{ agent_errors }}</ul>
    {% endif %}
  </div>
{% endif %}

