{% liquid
  assign text = shop.metaobjects['$app:wa_widget_text']['default']
  assign fallback = 'wa_chat.defaults.greeting_title' | t
  assign greeting_title = text.greeting_title.value | strip | default: fallback
  assign fallback = 'wa_chat.defaults.greeting_text' | t
  assign greeting_text = text.greeting_text.value | strip | default: fallback
  assign fallback = 'wa_chat.defaults.button_label' | t
  assign label = text.button_label.value | strip | default: fallback
  assign fallback = 'wa_chat.defaults.offline_message' | t
  assign offline_message = text.offline_message.value | strip | default: fallback
  assign fallback = 'wa_chat.defaults.default_message' | t
  assign message = text.default_message.value | strip | default: fallback

  assign product_title = 'wa_chat.defaults.your_products' | t
  assign product_url = request.origin
  if template.name == 'product' and product
    assign product_title = product.title
    assign product_url = request.origin | append: product.url
    if block.settings.product_message_enabled
      assign fallback = 'wa_chat.defaults.product_message' | t
      assign message = text.product_message.value | strip | default: fallback
    endif
  endif
  assign message = message | replace: '[product_title]', product_title | replace: '[product_url]', product_url
  assign encoded_message = message | url_encode | replace: '+', '%20'

  assign lang = request.locale.iso_code | split: '-' | first
  assign dir = 'ltr'
  if lang == 'ar' or lang == 'ur' or lang == 'fa' or lang == 'he'
    assign dir = 'rtl'
  endif

  assign background = block.settings.background
  assign foreground = block.settings.foreground
  assign contrast = background | color_contrast: foreground
  assign contrast_adjusted = false
  if contrast < 4.5
    assign contrast_adjusted = true
    assign contrast_light = background | color_contrast: '#ffffff'
    assign contrast_dark = background | color_contrast: '#111111'
    if contrast_dark > contrast_light
      assign foreground = '#111111'
    else
      assign foreground = '#ffffff'
    endif
  endif

  assign agent_keys = ''
  for entry in shop.metaobjects['$app:wa_agent'].values
    assign sort_key = entry.position.value | default: 0 | plus: 1000
    assign agent_keys = agent_keys | append: sort_key | append: '|' | append: entry.system.handle | append: ','
  endfor
  assign agent_keys = agent_keys | split: ',' | sort

  assign valid_agent_handles = ''
  assign first_phone = ''
  assign agent_errors = ''
  for key in agent_keys
    assign handle = key | split: '|' | last
    assign agent = shop.metaobjects['$app:wa_agent'][handle]
    assign phone = agent.phone.value | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
    assign non_digits = phone | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
    assign first_digit = phone | slice: 0
    if phone == blank or non_digits != blank or first_digit == '0' or phone.size < 8 or phone.size > 15
      assign safe_name = agent.name.value | escape
      assign agent_errors = agent_errors | append: '<li>' | append: safe_name | append: '</li>'
      continue
    endif
    assign valid_agent_handles = valid_agent_handles | append: handle | append: ','
    if first_phone == blank
      assign first_phone = phone
    endif
  endfor
  assign valid_agent_handles = valid_agent_handles | split: ','

  assign question_keys = ''
  for entry in shop.metaobjects['$app:wa_quick_question'].values
    assign sort_key = entry.position.value | default: 0 | plus: 1000
    assign question_keys = question_keys | append: sort_key | append: '|' | append: entry.system.handle | append: ','
  endfor
  assign question_keys = question_keys | split: ',' | sort

  assign faq_keys = ''
  for entry in shop.metaobjects['$app:wa_faq'].values
    assign sort_key = entry.position.value | default: 0 | plus: 1000
    assign faq_keys = faq_keys | append: sort_key | append: '|' | append: entry.system.handle | append: ','
  endfor
  assign faq_keys = faq_keys | split: ',' | sort
  assign has_faqs = false
  if faq_keys.size > 0
    assign has_faqs = true
  endif

  assign open_days = ''
  assign day_keys = 'hours_sun,hours_mon,hours_tue,hours_wed,hours_thu,hours_fri,hours_sat' | split: ','
  for day_key in day_keys
    if block.settings[day_key]
      assign open_days = open_days | append: forloop.index0 | append: ','
    endif
  endfor
%}
{% if first_phone != blank %}
  <div
    class="wa-chat wa-chat--{{ block.settings.position }}{% unless block.settings.show_label %} wa-chat--icon-only{% endunless %}{% unless block.settings.show_mobile %} wa-chat--hide-mobile{% endunless %}{% unless block.settings.show_desktop %} wa-chat--hide-desktop{% endunless %}"
    style="--wa-background: {{ background }}; --wa-foreground: {{ foreground }}; --wa-bottom: {{ block.settings.bottom_offset }}px;"
    dir="{{ dir }}"
    lang="{{ request.locale.iso_code }}"
    data-wa-chat
    data-page-type="{{ template.name }}"
    data-design-mode="{{ request.design_mode }}"
    data-hours-enabled="{{ block.settings.hours_enabled }}"
    data-days="{{ open_days }}"
    data-open="{{ block.settings.open_time }}"
    data-close="{{ block.settings.close_time }}"
    data-time-zone="{{ block.settings.time_zone }}"
    data-store-offset="{{ 'now' | date: '%z' }}"
    data-online-label="{{ 'wa_chat.status.online' | t | escape }}"
    data-away-label="{{ 'wa_chat.status.away' | t | escape }}"
    data-open24-label="{{ 'wa_chat.status.open_24_hours' | t | escape }}"
    data-online-heading="{{ 'wa_chat.agents.online_heading' | t | escape }}"
    data-offline-heading="{{ 'wa_chat.agents.offline_heading' | t | escape }}"
    {{ block.shopify_attributes }}
  >
    <details class="wa-chat__details"{% if request.design_mode %} open{% endif %}>
      <summary class="wa-chat__button" aria-label="{{ label | escape }}">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M21 11.5a9 9 0 0 1-13.3 7.9L3 21l1.6-4.7A9 9 0 1 1 21 11.5Z"/>
          <path d="M8 7.5c-.5 3.8 2.7 7 6.5 7l1-2-2-1-.8 1c-1.5-.6-2.6-1.7-3.2-3.2l1-.8-1-2Z"/>
        </svg>
        {% if block.settings.show_label %}<span>{{ label | escape }}</span>{% endif %}
      </summary>
      <div class="wa-chat__panel" role="region" aria-labelledby="WaChatTitle-{{ block.id }}">
        <div class="wa-chat__header">
          <p class="wa-chat__title" id="WaChatTitle-{{ block.id }}" tabindex="-1" data-wa-title>{{ greeting_title | escape }}</p>
          {% if greeting_text != blank %}
            <p class="wa-chat__subtitle">{{ greeting_text | escape }}</p>
          {% endif %}
          <div class="wa-chat__status" data-wa-status hidden>
            <p class="wa-chat__status-line"><span class="wa-chat__dot" aria-hidden="true"></span><span data-wa-status-text></span></p>
            <p class="wa-chat__hours" data-wa-hours></p>
          </div>
          <button type="button" class="wa-chat__close" data-wa-close aria-label="{{ 'wa_chat.general.close' | t | escape }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>

        {% if has_faqs %}
          <div class="wa-chat__tabs" role="tablist" aria-label="{{ 'wa_chat.tabs.label' | t | escape }}" data-wa-tablist>
            <button type="button" class="wa-chat__tab" role="tab" id="WaChatTab-chat-{{ block.id }}" aria-controls="WaChatPanel-chat-{{ block.id }}" aria-selected="true" data-wa-tab>
              {{ 'wa_chat.tabs.chat' | t }}
            </button>
            <button type="button" class="wa-chat__tab" role="tab" id="WaChatTab-faq-{{ block.id }}" aria-controls="WaChatPanel-faq-{{ block.id }}" aria-selected="false" tabindex="-1" data-wa-tab>
              {{ 'wa_chat.tabs.faq' | t }}
            </button>
          </div>
        {% endif %}

        <div class="wa-chat__body" id="WaChatPanel-chat-{{ block.id }}"{% if has_faqs %} role="tabpanel" aria-labelledby="WaChatTab-chat-{{ block.id }}"{% endif %}>
          {% if request.design_mode %}
            {% if agent_errors != blank %}
              <div class="wa-chat__notice">
                These agents have an invalid WhatsApp number and are hidden. Fix them in the WhatsApp Chat Pro app.
                <ul>{{ agent_errors }}</ul>
              </div>
            {% endif %}
            {% if contrast_adjusted %}
              <div class="wa-chat__notice">
                The icon and text colour didn’t have enough contrast with the background, so a readable colour is used instead.
              </div>
            {% endif %}
          {% endif %}
          <p class="wa-chat__offline" data-wa-offline data-template="{{ offline_message | escape }}" hidden></p>

          {% if question_keys.size > 0 %}
            <p class="wa-chat__list-heading" id="WaChatQuick-{{ block.id }}">{{ 'wa_chat.quick.heading' | t }}</p>
            <ul class="wa-chat__chips" role="list" aria-labelledby="WaChatQuick-{{ block.id }}">
              {% for key in question_keys %}
                {% liquid
                  assign handle = key | split: '|' | last
                  assign question = shop.metaobjects['$app:wa_quick_question'][handle]
                  assign question_phone = first_phone
                  assign question_agent = question.agent.value
                  if question_agent and valid_agent_handles contains question_agent.system.handle
                    assign question_phone = question_agent.phone.value | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
                  endif
                  assign question_message = question.message.value | replace: '[product_title]', product_title | replace: '[product_url]', product_url | url_encode | replace: '+', '%20'
                %}
                <li>
                  <a
                    class="wa-chat__chip"
                    href="https://wa.me/{{ question_phone }}?text={{ question_message | escape }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-wa-track="quick_question_click"
                    data-wa-target="{{ handle | escape }}"
                  >
                    {{- question.label.value | escape -}}
                    <span class="wa-chat__visually-hidden"> ({{ 'wa_chat.agents.opens_whatsapp' | t }})</span>
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}

          <p class="wa-chat__list-heading" id="WaChatAgents-{{ block.id }}" data-wa-list-heading>{{ 'wa_chat.agents.online_heading' | t }}</p>
          <ul class="wa-chat__agents" role="list" aria-labelledby="WaChatAgents-{{ block.id }}">
            {% for handle in valid_agent_handles %}
              {% liquid
                assign agent = shop.metaobjects['$app:wa_agent'][handle]
                assign phone = agent.phone.value | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
                assign agent_name = agent.name.value | strip | default: 'WhatsApp'
                assign agent_role = agent.description.value | strip
              %}
              <li>
                <a
                  class="wa-chat__agent"
                  href="https://wa.me/{{ phone }}{% if encoded_message != blank %}?text={{ encoded_message | escape }}{% endif %}"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-wa-track="agent_click"
                  data-wa-target="{{ handle | escape }}"
                >
                  <span class="wa-chat__avatar" aria-hidden="true">{{ agent_name | slice: 0 | upcase | escape }}</span>
                  <span class="wa-chat__agent-text">
                    <span class="wa-chat__agent-name">{{ agent_name | escape }}</span>
                    {% if agent_role != blank %}<span class="wa-chat__agent-role">{{ agent_role | escape }}</span>{% endif %}
                  </span>
                  <span class="wa-chat__visually-hidden">({{ 'wa_chat.agents.opens_whatsapp' | t }})</span>
                  <svg class="wa-chat__agent-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M21 11.5a9 9 0 0 1-13.3 7.9L3 21l1.6-4.7A9 9 0 1 1 21 11.5Z"/>
                    <path d="M8 7.5c-.5 3.8 2.7 7 6.5 7l1-2-2-1-.8 1c-1.5-.6-2.6-1.7-3.2-3.2l1-.8-1-2Z"/>
                  </svg>
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>

        {% if has_faqs %}
          <div class="wa-chat__body" id="WaChatPanel-faq-{{ block.id }}" role="tabpanel" aria-labelledby="WaChatTab-faq-{{ block.id }}" hidden>
            <label class="wa-chat__search-label" for="WaChatSearch-{{ block.id }}">{{ 'wa_chat.faq.search_label' | t }}</label>
            <input
              class="wa-chat__search"
              type="search"
              id="WaChatSearch-{{ block.id }}"
              placeholder="{{ 'wa_chat.faq.search_placeholder' | t | escape }}"
              autocomplete="off"
              data-wa-faq-search
              data-result-template="{{ 'wa_chat.faq.result_count' | t: number: '[number]' | escape }}"
            >
            <p class="wa-chat__visually-hidden" role="status" aria-live="polite" data-wa-faq-status></p>
            <ul class="wa-chat__faqs" role="list">
              {% for key in faq_keys %}
                {% liquid
                  assign handle = key | split: '|' | last
                  assign faq = shop.metaobjects['$app:wa_faq'][handle]
                  assign search_text = faq.question.value | append: ' ' | append: faq.answer.value | downcase
                %}
                <li data-wa-faq data-search="{{ search_text | escape }}">
                  <details class="wa-chat__faq" data-wa-faq-item data-wa-target="{{ handle | escape }}">
                    <summary>{{ faq.question.value | escape }}</summary>
                    <div class="wa-chat__faq-answer">{{ faq.answer.value | escape | newline_to_br }}</div>
                  </details>
                </li>
              {% endfor %}
            </ul>
            <p class="wa-chat__empty" data-wa-faq-empty hidden>{{ 'wa_chat.faq.no_results' | t }}</p>
            <div class="wa-chat__faq-contact">
              <p class="wa-chat__list-heading">{{ 'wa_chat.faq.contact_heading' | t }}</p>
              <a
                class="wa-chat__contact"
                href="https://wa.me/{{ first_phone }}{% if encoded_message != blank %}?text={{ encoded_message | escape }}{% endif %}"
                target="_blank"
                rel="noopener noreferrer"
                data-wa-track="faq_contact_click"
              >
                {{ 'wa_chat.faq.contact_button' | t }}
                <span class="wa-chat__visually-hidden">({{ 'wa_chat.agents.opens_whatsapp' | t }})</span>
              </a>
            </div>
          </div>
        {% endif %}
      </div>
    </details>
  </div>
{% elsif request.design_mode %}
  <div class="wa-chat-setup" {{ block.shopify_attributes }}>
    {% if agent_errors == blank %}
      WhatsApp Chat Pro: add at least one agent with a WhatsApp number in the WhatsApp Chat Pro app.
    {% else %}
      WhatsApp Chat Pro: these agents have an invalid WhatsApp number. Fix them in the WhatsApp Chat Pro app.
      <ul>{{ agent_errors }}</ul>
    {% endif %}
  </div>
{% endif %}

{% schema %}
